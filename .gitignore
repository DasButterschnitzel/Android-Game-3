# Godot
game/.godot/
*.import.tmp
# Android Gradle build template (installed by godot --install-android-build-template)
game/android/
# Android plugin build outputs (the AARs that matter are copied to game/addons/*/bin/)
android_plugins/**/build/
android_plugins/**/.gradle/
android_plugins/**/local.properties
# Build outputs (APKs are delivered via CI artifacts / direct handoff, not git)
builds/**/*.apk
builds/**/*.apk.idsig
builds/**/*.aab
builds/**/*.build.log
builds/**/tmp/
# Python
__pycache__/
*.pyc
# OS
.DS_Store
builds/linux/
# Build reports are copied to docs/builds/ for releases worth keeping
builds/**/*.verify.txt
builds/**/*.ads-check.txt
# Local agent worktrees (Claude Code)
.claude/
