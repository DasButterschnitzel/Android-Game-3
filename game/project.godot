; Engine configuration file.
config_version=5

[application]

config/name="NACHHALL"
config/version="0.6.0"
run/main_scene="res://scenes/menus/main_menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
run/low_processor_mode=false
config/quit_on_go_back=false
boot_splash/bg_color=Color(0.05, 0.05, 0.08, 1)
boot_splash/show_image=false
config/icon="res://assets/icon/icon_192.png"

[autoload]

Save="*res://scripts/save/save_store.gd"
Audio="*res://scripts/audio/audio_director.gd"
Flow="*res://scripts/core/game_flow.gd"
Ads="*res://scripts/ads/ad_service.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1
window/energy_saving/keep_screen_on=true

[editor_plugins]

enabled=PackedStringArray("res://addons/nachhall_ads/plugin.cfg")

[input_devices]

pointing/emulate_touch_from_mouse=true
pointing/emulate_mouse_from_touch=true

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.05, 0.05, 0.08, 1)
anti_aliasing/quality/msaa_2d=0
