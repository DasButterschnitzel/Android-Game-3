class_name ArtKit
extends RefCounted
## Procedural art helpers for the "paper night" look: soft glow sprite,
## cut-paper rooftop silhouettes and two-tone paper shading for fireworks.
## Everything is generated at runtime: no image assets, tiny APK footprint.

static var _glow: Texture2D


## Radial soft dot used for additive glows and sparks (one texture, many quads).
static func glow_texture() -> Texture2D:
	if _glow:
		return _glow
	var g := Gradient.new()
	g.set_color(0, Color(1, 1, 1, 1))
	g.set_color(1, Color(1, 1, 1, 0))
	g.add_point(0.25, Color(1, 1, 1, 0.65))
	g.add_point(0.6, Color(1, 1, 1, 0.12))
	var t := GradientTexture2D.new()
	t.gradient = g
	t.width = 64
	t.height = 64
	t.fill = GradientTexture2D.FILL_RADIAL
	t.fill_from = Vector2(0.5, 0.5)
	t.fill_to = Vector2(1.0, 0.5)
	_glow = t
	return t


## One texture for every soft dot, ring and symbol of a scene, so they batch
## into a single draw call (Batch2D). Generated by tools/art/make_atlas.py;
## name -> [cell rect, reference radius the cell was drawn at]. A unit test
## checks that the cells hold their shapes.
const ATLAS_CELLS := {
	"glow": [Rect2(0, 0, 64, 64), 32.0],
	"disc64": [Rect2(64, 0, 64, 64), 30.0],
	"disc32": [Rect2(128, 0, 32, 32), 14.0],
	"disc16": [Rect2(160, 0, 16, 16), 6.5],
	"slot": [Rect2(176, 0, 16, 16), 5.5],
	"tri": [Rect2(192, 0, 32, 32), 11.5],
	"square": [Rect2(224, 0, 32, 32), 11.0],
	"diamond": [Rect2(192, 32, 32, 32), 12.0],
	"guide": [Rect2(0, 64, 80, 80), 32.0],
	"plates": [Rect2(80, 64, 80, 80), 32.0],
	"plates3": [Rect2(160, 64, 80, 80), 32.0],
	"track": [Rect2(240, 64, 64, 64), 27.5],
	"dashring": [Rect2(0, 144, 128, 128), 60.0],
	"hitring": [Rect2(128, 144, 96, 96), 44.0],
}
const ATLAS_GLOW := Rect2(0, 0, 64, 64)

static var _atlas: Texture2D


static func atlas() -> Texture2D:
	if _atlas == null:
		_atlas = load("res://assets/sprites/atlas.png")
	return _atlas


## Screen rect and atlas cell for a disc of radius r at p (the smallest cell that is not upscaled much).
static func disc_rect(p: Vector2, r: float) -> Array:
	var cell: Array = ATLAS_CELLS["disc64"]
	if r <= 7.0:
		cell = ATLAS_CELLS["disc16"]
	elif r <= 15.0:
		cell = ATLAS_CELLS["disc32"]
	var src: Rect2 = cell[0]
	var s: float = r / float(cell[1]) * src.size.x * 0.5
	return [Rect2(p - Vector2(s, s), Vector2(s, s) * 2.0), src]


## Draws atlas cell `name` centred at `center` so that its reference radius
## becomes r (stroke widths scale along). With `rot` the canvas transform is
## set and reset to identity, so not for use inside another draw transform.
static func sprite(ci: CanvasItem, name: String, center: Vector2, r: float, color: Color, rot := 0.0) -> void:
	var cell: Array = ATLAS_CELLS[name]
	var src: Rect2 = cell[0]
	var size: Vector2 = src.size * (r / float(cell[1]))
	if rot == 0.0:
		ci.draw_texture_rect_region(atlas(), Rect2(center - size * 0.5, size), src, color)
	else:
		ci.draw_set_transform(center, rot)
		ci.draw_texture_rect_region(atlas(), Rect2(-size * 0.5, size), src, color)
		ci.draw_set_transform(Vector2.ZERO)


## Cut-paper skyline: returns polygons (one per layer, back to front).
## Deterministic for a seed so every round has its own little town.
static func skyline(width: float, base_y: float, seed_value: int, layers := 3) -> Array[PackedVector2Array]:
	var rng := RandomNumberGenerator.new()
	rng.seed = seed_value
	var out: Array[PackedVector2Array] = []
	for layer in layers:
		var pts := PackedVector2Array()
		var x := -20.0
		var top := base_y - 40.0 - (layers - layer) * 36.0
		pts.append(Vector2(x, base_y + 400))
		while x < width + 20:
			var w := rng.randf_range(48, 120)
			var h := rng.randf_range(20, 110) * (0.6 + 0.2 * (layers - layer))
			var y := top - h
			pts.append(Vector2(x, y))
			# Roof shape: flat, pitched or with a small chimney.
			match rng.randi_range(0, 2):
				0:
					pts.append(Vector2(x + w, y))
				1:
					pts.append(Vector2(x + w * 0.5, y - rng.randf_range(16, 34)))
					pts.append(Vector2(x + w, y))
				_:
					pts.append(Vector2(x + w * 0.62, y))
					pts.append(Vector2(x + w * 0.62, y - 18))
					pts.append(Vector2(x + w * 0.74, y - 18))
					pts.append(Vector2(x + w * 0.74, y))
					pts.append(Vector2(x + w, y))
			x += w
			pts.append(Vector2(x, y))
		pts.append(Vector2(x, base_y + 400))
		out.append(_dedupe(pts))
	return out


static func _dedupe(pts: PackedVector2Array) -> PackedVector2Array:
	var out := PackedVector2Array()
	for p in pts:
		if out.is_empty() or out[out.size() - 1].distance_to(p) > 0.5:
			out.append(p)
	return out


## Lit windows for a skyline layer (positions), sparse and deterministic.
static func windows(poly: PackedVector2Array, seed_value: int, density := 0.25) -> PackedVector2Array:
	var rng := RandomNumberGenerator.new()
	rng.seed = seed_value
	var out := PackedVector2Array()
	for i in range(1, poly.size() - 2):
		var a := poly[i]
		var b := poly[i + 1]
		if absf(a.y - b.y) < 0.5 and b.x - a.x > 30:
			for k in int((b.x - a.x) / 26):
				if rng.randf() < density:
					out.append(Vector2(a.x + 14 + k * 26, a.y + rng.randf_range(22, 70)))
	return out
